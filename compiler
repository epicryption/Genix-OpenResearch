    query_file = "generated/sample_query.fasta"
    with open(query_file, "w") as f:
        f.write(">Query_Target\nMAVRELIISGLVLLALVVWGVIG")
        
    run_local_blast(query_file, input_fasta, "generated/blast_alignment_output.txt")

