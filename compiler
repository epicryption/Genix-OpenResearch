    # 1. Processing pipeline dataset steps
    data_matrix, counts = run_extended_pipeline(input_fasta, output_table, tax_id_blacklist={'9606'})
    
    # 2. Rendering distribution analytical diagrams
    generate_plots(counts, output_chart)
    
    # 3. Running targeted structural alignment query matches
